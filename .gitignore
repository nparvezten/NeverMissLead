# NeverMissLead — project-level .gitignore

# Node & JavaScript dependencies
node_modules/
**/node_modules/
frontend/dist/
frontend/test-results/
frontend/.angular/
test-results/
**/test-results/
e2e/test-results/
e2e/playwright-report/

# .NET build output
backend/bin/
backend/obj/
backend/**/bin/
backend/**/obj/

# Python virtual environment & cache
.venv/
**/.venv/
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
**/.pytest_cache/

# Environment secrets — NEVER commit
# Real API keys (LLM_PROVIDER, OPENAI_API_KEY, etc.) go in appsettings.Local.json
# which is loaded by ASP.NET Core but git-ignored by the lines below.
.env
*.env.local
backend/API/appsettings.Local.json
backend/API/appsettings.*.Local.json
backend/API/appsettings.Production.json

# IDE
.idea/
.vscode/
*.suo
*.user

# macOS
.DS_Store
